# --- Base de datos ---
# Usuario de la app (NO superusuario: así Row Level Security se aplica)
DATABASE_URL=postgres://chatea_app:chatea_app@localhost:5433/chatea
# Usuario dueño para migraciones
MIGRATION_DATABASE_URL=postgres://chatea:chatea@localhost:5433/chatea
REDIS_URL=redis://localhost:6379

# --- Seguridad ---
# 32 bytes en base64: openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- URLs ---
API_URL=http://localhost:4000
WEB_URL=http://localhost:3100

# --- Login con Google (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (opcional; sin esto, los correos se imprimen en el log del API) ---
SMTP_URL=
EMAIL_FROM="Chatea <no-reply@example.com>"

# --- WhatsApp Cloud API ---
# Versión de la Graph API de Meta (las versiones duran ~2 años)
WHATSAPP_GRAPH_VERSION=v23.0
